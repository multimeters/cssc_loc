<?xml version="1.0"?>
<package format="3">
  <name>aps_bag_localization</name>
  <version>0.1.0</version>
  <description>Live and replay localization with native Autoware wheel/IMU, gyro odometer, NDT and EKF map fusion.</description>
  <maintainer email="maintainers@example.com">APS localization maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>autoware_internal_localization_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>autoware_gyro_odometer</exec_depend>
  <exec_depend>autoware_ekf_localizer</exec_depend>
  <exec_depend>autoware_ndt_scan_matcher</exec_depend>
  <exec_depend>autoware_map_loader</exec_depend>
  <exec_depend>aps_ndt_localization</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
